{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/.dart_tool": true,
    "**/.git": true,
    "docs/lib/generated/": true,
    "docs/**/*.options.dart": true,
    "docs/**/*.imports.dart": true,
  },
  "dart.lineLength": 100,
  "[dart]": {
    "editor.rulers": [
      80
    ]
  },
  "cSpell.enabled": true,
  "cSpell.ignorePaths": [
    "LICENSE",
    "pubspec.lock",
    "pubspec.yaml",
    "*.code-workspace",
    ".git/{info,lfs,logs,refs,objects}/**",
    ".git/{index,*refs,*HEAD}",
    ".github/",
    ".gitignore",
    ".vscode/"
  ],
  "cSpell.words": [
    "AABB",
    "AABBs",
    "adjugate",
    "Auris",
    "broadphase",
    "broadphased",
    "Cheatsheet",
    "despawning",
    "desyncs",
    "glsl",
    "hitbox",
    "hitboxes",
    "inspectable",
    "ivector",
    "Jaspr",
    "lede",
    "LTWH",
    "Mewyn",
    "misha",
    "narrowphase",
    "narrowphased",
    "paletted",
    "parentless",
    "pregenerates",
    "premultiplies",
    "preorder",
    "pubspec",
    "reentrancy",
    "reentrantly",
    "reimplementation",
    "renderable",
    "reparented",
    "reparenting",
    "reprioritize",
    "retarget",
    "riverpod",
    "Roboto",
    "Ryzen",
    "spritesheet",
    "spritesheets",
    "tearoffs",
    "tombstoned",
    "unflexed",
    "unlisten",
    "unresized",
    "unrotated",
    "untargeted",
    "vmservice",
    "wasd",
    "widgetbook",
    "wordmark",
    "workspace",
    "zoomable"
  ],
}
