// SPDX-AI-Disclosure: none
{
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.formatOnSave": true,
  "files.insertFinalNewline": true,
  "files.exclude": {
    "**/.dart_tool": true,
    "**/.git": true,
    "docs/lib/generated/": true,
    "docs/**/*.options.dart": true,
    "docs/**/*.imports.dart": true,
  },
  "[dart]": {
    "editor.rulers": [
      80
    ]
  },
  "cSpell.enabled": true,
  "cSpell.ignorePaths": [
    "LICENSE",
    "pubspec.lock",
    "pubspec.yaml",
    "*.code-workspace",
    ".git/{info,lfs,logs,refs,objects}/**",
    ".git/{index,*refs,*HEAD}",
    ".github/",
    ".gitignore",
    ".vscode/"
  ],
  "cSpell.words": [
    "AABB",
    "AABBs",
    "adjugate",
    "backdoors",
    "broadphase",
    "broadphased",
    "cheatsheet",
    "codegen",
    "despawning",
    "desyncs",
    "footguns",
    "frontmatter",
    "gamepads",
    "glsl",
    "goldens",
    "hitbox",
    "hitboxes",
    "inspectable",
    "ivector",
    "Jaspr",
    "lede",
    "lifecycles",
    "linecap",
    "linejoin",
    "Lockfiles",
    "LTWH",
    "lucide",
    "Mewyn",
    "minmax",
    "Misha",
    "narrowphase",
    "narrowphased",
    "paletted",
    "parentless",
    "pregenerates",
    "premultiplies",
    "preorder",
    "pubspec",
    "reentrancy",
    "reentrantly",
    "reimplementation",
    "reloadable",
    "renderable",
    "reparented",
    "reparenting",
    "reprioritize",
    "retarget",
    "riverpod",
    "Roboto",
    "Ryzen",
    "spritesheet",
    "spritesheets",
    "tearoffs",
    "tombstoned",
    "typesafe",
    "unclaims",
    "unflexed",
    "unlisten",
    "unresized",
    "unrotated",
    "unshifted",
    "untargeted",
    "unwatch",
    "vmservice",
    "wasd",
    "webp",
    "widgetbook",
    "wireframes",
    "wordmark",
    "workspace",
    "zoomable"
  ],
}
